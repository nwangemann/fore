{
  "expo": {
    "name": "fore!",
    "slug": "fore",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "fore",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.nwangemann.fore"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E5B3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "fore!",
      "themeColor": "#1E5B3A",
      "description": "A golf-themed weather dashboard."
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "fore! uses your location to tee up the forecast where you are."
        }
      ]
    ]
  }
}
